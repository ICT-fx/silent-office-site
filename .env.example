# ------------------------------------------------------------------
#  Copiez ce fichier en .env.local et remplissez les valeurs.
#  Détail de la mise en place : docs/setup-contact-et-rendez-vous.md
# ------------------------------------------------------------------

# --- Réservation d'appel (Cal.com) --------------------------------
# Identifiant public Cal.com : la partie <handle> de cal.com/<handle>.
# Exposé au navigateur (préfixe VITE_), ce n'est pas un secret.
# Valeur par défaut dans le code : « flowera.ch » — inutile de la redéclarer.
VITE_CAL_USERNAME=flowera.ch

# Slugs des deux créneaux, seulement si vous les renommez côté Cal.com.
# Par défaut : 30min (existe déjà) et 60min (à créer).
VITE_CAL_SLUG_30=30min
VITE_CAL_SLUG_60=60min

# --- Envoi du formulaire de contact (Resend) ----------------------
# ⚠ Variables SERVEUR, lues par api/contact.ts : PAS de préfixe VITE_,
#   sinon la clé se retrouverait dans le bundle servi aux visiteurs.
#   À déclarer aussi dans Vercel → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif : par défaut fantin.schellekens@flowera.ch
CONTACT_TO_EMAIL=fantin.schellekens@flowera.ch

# Facultatif : expéditeur des messages. Le domaine doit être vérifié
# dans Resend. Par défaut « Flowera <contact@flowera.ch> ».
CONTACT_FROM_EMAIL=Flowera <contact@flowera.ch>
